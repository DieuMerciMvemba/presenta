# Configuration des chemins du système UCC Face Recognition
# Utilisez toujours des guillemets "" pour les chemins qui contiennent des espaces

# Chemin du dossier racine du projet
PROJECT_ROOT="d:\cnn_sys"

# Chemin du dossier camera_system
CAMERA_SYSTEM_PATH="d:\cnn_sys\camera_system"

# Chemin du dossier kivy_app
KIVY_APP_PATH="d:\cnn_sys\camera_system\kivy_app"

# Chemin du dossier Dataset
DATASET_PATH="d:\cnn_sys\Dataset"

# Chemin du dossier data (FAISS et métadonnées)
DATA_PATH="d:\cnn_sys\camera_system\data"

# Chemin du dossier config
CONFIG_PATH="d:\cnn_sys\camera_system\config"

# Chemin du dossier reports
REPORTS_PATH="D:\cnn_sys\camera_system\kivy_app\reports"

# Chemin du dossier temp_charts
TEMP_CHARTS_PATH="d:\cnn_sys\temp_charts"

# Chemin du dossier docs
DOCS_PATH="d:\cnn_sys\docs"

# Chemin de l'environnement conda learning
CONDA_ENV_PATH="C:\Users\dM\anaconda3\envs\learning"
CONDA_PYTHON_PATH="C:\Users\dM\anaconda3\envs\learning\python.exe"

# Configuration MySQL
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="ucc_face_recognition"
MYSQL_USER="root"
MYSQL_PASSWORD="admin123"

# Configuration de l'application
APP_NAME="Système de Reconnaissance Faciale - UCC"
APP_VERSION="1.0.0"
